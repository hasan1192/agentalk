{
  "name": "agentalk",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Independent AI voices. One shared conversation.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && npm run licenses:check",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "format": "prettier --write src electron scripts test *.json *.ts *.html docs README.md",
    "brand:build": "node scripts/build-brand.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test:package": "node scripts/release-artifact.mjs test",
    "release:archive": "node scripts/release-artifact.mjs archive",
    "media:setup": "node scripts/setup-media.mjs",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.10.2",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "productName": "Agentalk"
}
